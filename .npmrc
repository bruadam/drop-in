# Several dependencies (react-native-web, @clerk/expo, jest-expo's peer on
# @react-native/jest-preset) declare peer ranges that lag their SDK 57
# ecosystem's actual compatible versions. Without this, `npm ci` on EAS
# Build (which doesn't get an interactive flag to pass) fails even though
# the resolved tree works fine — see docs/CI-CD.md.
legacy-peer-deps=true
