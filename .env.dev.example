# Copy to .env.dev, fill in real values, then run:
#   node scripts/push-env.mjs .env.dev development
# This is what EAS's "development" environment holds — a hosted (but cheap)
# dev Supabase project and a Clerk *test* instance, because CI runners can
# never reach your laptop's localhost. This is NOT the same as .env, which
# points at supabase start on your own machine.

APP_ENV=development

EXPO_PUBLIC_SUPABASE_URL=REPLACE_WITH_HOSTED_DEV_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_HOSTED_DEV_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_HOSTED_DEV_SUPABASE_SERVICE_ROLE_KEY

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_TEST_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_TEST_SECRET_KEY
# A dedicated Clerk test user Maestro signs in as on every run.
E2E_TEST_ACCOUNT_EMAIL=e2e-runner@dropin-test.app
E2E_TEST_ACCOUNT_PASSWORD=REPLACE_WITH_TEST_ACCOUNT_PASSWORD
# Invite code for a seeded "E2E Test Community" tenant — never a real one.
E2E_TEST_COMMUNITY_INVITE_CODE=REPLACE_WITH_SEEDED_TEST_INVITE_CODE

POLAR_ACCESS_TOKEN=REPLACE_WITH_POLAR_SANDBOX_TOKEN
POLAR_WEBHOOK_SECRET=REPLACE_WITH_POLAR_SANDBOX_WEBHOOK_SECRET

EAS_PROJECT_ID=25c7e9df-deb1-486e-9884-076426c88173
