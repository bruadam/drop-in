# Copy to .env for your own machine only. Never committed, never pushed to EAS.
# This is the ONE file that's allowed to point at a truly local backend,
# because only your own machine can reach localhost.

APP_ENV=development

# Local Supabase (started with: supabase start)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SUPABASE_SERVICE_ROLE_KEY

# Clerk DEVELOPMENT instance (a separate Clerk instance from staging/prod,
# created for free in the Clerk dashboard — never reuse a prod instance here)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_DEV_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_DEV_SECRET_KEY

# Polar.sh sandbox
POLAR_ACCESS_TOKEN=REPLACE_WITH_POLAR_SANDBOX_TOKEN
POLAR_WEBHOOK_SECRET=REPLACE_WITH_POLAR_SANDBOX_WEBHOOK_SECRET

EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID
