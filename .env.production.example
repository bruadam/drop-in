# Copy to .env.production, fill in real values, then run:
#   node scripts/push-env.mjs .env.production production
# Every value here should be marked "secret" or "sensitive" visibility in
# EAS (see scripts/push-env.mjs), never "plaintext".

APP_ENV=production

EXPO_PUBLIC_SUPABASE_URL=REPLACE_WITH_PRODUCTION_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_PRODUCTION_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_PRODUCTION_SUPABASE_SERVICE_ROLE_KEY

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PRODUCTION_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_PRODUCTION_SECRET_KEY

POLAR_ACCESS_TOKEN=REPLACE_WITH_POLAR_LIVE_TOKEN
POLAR_WEBHOOK_SECRET=REPLACE_WITH_POLAR_LIVE_WEBHOOK_SECRET

EAS_PROJECT_ID=REPLACE_WITH_EAS_PROJECT_ID
