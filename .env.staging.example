# Copy to .env.staging, fill in real values, then run:
#   node scripts/push-env.mjs .env.staging preview
# Maps to EAS's "preview" environment (internal TestFlight builds).

APP_ENV=preview

EXPO_PUBLIC_SUPABASE_URL=REPLACE_WITH_STAGING_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_SUPABASE_SERVICE_ROLE_KEY

EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_STAGING_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_STAGING_SECRET_KEY
E2E_TEST_ACCOUNT_EMAIL=e2e-runner@dropin-test.app
E2E_TEST_ACCOUNT_PASSWORD=REPLACE_WITH_TEST_ACCOUNT_PASSWORD
E2E_TEST_COMMUNITY_INVITE_CODE=REPLACE_WITH_SEEDED_TEST_INVITE_CODE

POLAR_ACCESS_TOKEN=REPLACE_WITH_POLAR_SANDBOX_TOKEN
POLAR_WEBHOOK_SECRET=REPLACE_WITH_POLAR_SANDBOX_WEBHOOK_SECRET

EAS_PROJECT_ID=25c7e9df-deb1-486e-9884-076426c88173
